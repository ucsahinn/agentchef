prefix_rule(pattern = ["git", "remote", "rename"], decision = "prompt", justification = "Renaming Git remotes changes repository configuration and requires approval.")
prefix_rule(pattern = ["git", "remote", "remove"], decision = "prompt", justification = "Removing Git remotes changes repository configuration and requires approval.")
prefix_rule(pattern = ["git", "remote", "rm"], decision = "prompt", justification = "Removing Git remotes changes repository configuration and requires approval.")
prefix_rule(pattern = ["git", "remote", "set-head"], decision = "prompt", justification = "Changing a remote HEAD requires approval.")
prefix_rule(pattern = ["git", "remote", "set-branches"], decision = "prompt", justification = "Changing tracked remote branches requires approval.")
prefix_rule(pattern = ["git", "remote", "set-url"], decision = "prompt", justification = "Changing remote URLs requires approval.")
