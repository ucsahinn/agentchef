prefix_rule(pattern = ["npm", "view"], decision = "allow")
prefix_rule(pattern = ["npm", "ls"], decision = "allow")
prefix_rule(pattern = ["npm.cmd", "pack", "--dry-run", "--json", "--ignore-scripts"], decision = "allow")
prefix_rule(pattern = ["npm", "pack", "--dry-run", "--json", "--ignore-scripts"], decision = "allow")

