prefix_rule(pattern = ["git", "config", "--get", "core.hooksPath"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--global", "--get", "core.excludesfile"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--global", "--get", "core.hooksPath"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--get-all", "safe.directory"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--unset"], decision = "prompt", justification = "Mutating Git config requires approval.")
prefix_rule(pattern = ["git", "config", "--unset-all"], decision = "prompt", justification = "Mutating Git config requires approval.")
prefix_rule(pattern = ["git", "config", "--add"], decision = "prompt", justification = "Mutating Git config requires approval.")
prefix_rule(pattern = ["git", "config", "--replace-all"], decision = "prompt", justification = "Mutating Git config requires approval.")
prefix_rule(pattern = ["git", "config", "--edit"], decision = "prompt", justification = "Editing Git config requires approval.")

# Common local inspection that does not execute repository-controlled scripts.
