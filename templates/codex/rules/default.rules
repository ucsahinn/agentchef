prefix_rule(pattern = ["git", "check-ignore"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--get", "user.name"], decision = "allow")
prefix_rule(pattern = ["git", "config", "--get", "user.email"], decision = "allow")
