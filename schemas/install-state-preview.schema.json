{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Chef install-state preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "dryRunOnly",
    "source",
    "target",
    "options",
    "selectedComponentIds",
    "skippedComponentIds",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "codex-chef.install-state-preview.v1"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "dryRunOnly": {
      "const": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "packageVersion", "manifest", "manifestVersion"],
      "properties": {
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "const": "manifests/install-plan.json"
        },
        "manifestVersion": {
          "const": "codex-chef.install-plan.v1"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "codexHome", "agentsHome", "home"],
      "properties": {
        "platform": {
          "enum": ["windows", "unix"]
        },
        "codexHome": {
          "type": "string",
          "minLength": 1
        },
        "agentsHome": {
          "type": "string",
          "minLength": 1
        },
        "home": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "installSkills", "installGitGuards", "force", "noBackup", "redactPaths"],
      "properties": {
        "all": {
          "type": "boolean"
        },
        "installSkills": {
          "type": "boolean"
        },
        "installGitGuards": {
          "type": "boolean"
        },
        "force": {
          "type": "boolean"
        },
        "noBackup": {
          "type": "boolean"
        },
        "redactPaths": {
          "type": "boolean"
        }
      }
    },
    "selectedComponentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skippedComponentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "kind",
          "summary",
          "risk",
          "collision",
          "conflictPolicy",
          "backup",
          "noBackupPolicy",
          "force",
          "wouldMutateGlobalState",
          "selectedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "copy-file",
              "copy-directory",
              "generate-mcp-profile",
              "write-ownership-marker",
              "write-marketplace",
              "refresh-plugin-cache",
              "git-config",
              "chmod",
              "skill-install"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": ["low", "medium", "high"]
          },
          "collision": {
            "type": "string",
            "minLength": 1
          },
          "conflictPolicy": {
            "type": "string",
            "minLength": 1
          },
          "backup": {
            "type": "boolean"
          },
          "noBackupPolicy": {
            "enum": ["backup-before-existing-mutation", "creation-only", "incompatible", "not-applicable"]
          },
          "adoptionFlag": {
            "enum": ["AdoptGitIgnore", "AdoptGitHook", "AdoptGitExcludesFile", "AdoptGitHooksPath"]
          },
          "stateBackup": {
            "const": "codex-chef.global-git-guards-receipt@1"
          },
          "force": {
            "type": "boolean"
          },
          "wouldMutateGlobalState": {
            "const": true
          },
          "selectedBy": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "configSource": {
            "type": "string",
            "minLength": 1
          },
          "pluginTarget": {
            "type": "string",
            "minLength": 1
          },
          "pluginId": {
            "const": "codex-chef-workflows@codex-chef"
          },
          "mode": {
            "const": "+x"
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
