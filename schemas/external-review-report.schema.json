{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ucsahinn/agentchef/schemas/external-review-report.schema.json",
  "title": "AgentChef External Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "snapshotCommit", "snapshotContentSha256", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "reviewId": { "type": "string", "minLength": 12 },
    "snapshotCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "snapshotContentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "evidence", "file", "line", "recommendation", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "title": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "recommendation": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
