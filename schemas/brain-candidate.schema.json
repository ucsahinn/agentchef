{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-chef.dev/schemas/brain-candidate.schema.json",
  "title": "Codex Chef Brain candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateId", "type", "title", "projectId", "bodyMarkdown", "privacy", "confidence", "retention", "sourceRefs"],
  "properties": {
    "schemaVersion": { "const": "codex-chef.brain-candidate.v1" },
    "candidateId": { "type": "string", "format": "uuid" },
    "type": { "enum": ["capture", "project", "goal", "decision", "knowledge", "research", "profile", "preference", "active-thread", "session-summary"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,79}$" },
    "bodyMarkdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "privacy": { "enum": ["public", "local", "restricted"] },
    "confidence": { "enum": ["confirmed", "observed", "inferred", "unverified"] },
    "retention": { "enum": ["permanent", "project", "review-90d", "ephemeral-30d"] },
    "sourceRefs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
    "agentRoles": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" } }
  }
}
