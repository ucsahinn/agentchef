{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-chef.dev/schemas/brain-context-pack.schema.json",
  "title": "Codex Chef Brain context pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "agentRole", "query", "notes", "totalChars", "truncated", "untrusted"],
  "properties": {
    "schemaVersion": { "const": "codex-chef.brain-context-pack.v1" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,79}$" },
    "agentRole": { "type": ["string", "null"], "maxLength": 80, "pattern": "^[a-z][a-z0-9-]{0,79}$" },
    "query": { "type": "string", "maxLength": 4096 },
    "notes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relativePath", "title", "type", "projectId", "privacy", "confidence", "updated", "sourceRefs", "excerpt", "sha256", "score", "truncated", "agentRoles"],
        "properties": {
          "id": { "type": "string", "minLength": 3, "maxLength": 160 },
          "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:md|canvas)$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "type": { "enum": ["capture", "project", "goal", "decision", "knowledge", "research", "profile", "preference", "active-thread", "session-summary"] },
          "projectId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,79}$" },
          "privacy": { "enum": ["public", "local"] },
          "confidence": { "enum": ["confirmed", "observed", "inferred", "unverified"] },
          "updated": { "type": "string", "format": "date-time" },
          "sourceRefs": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
          "excerpt": { "type": "string", "maxLength": 5000 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "score": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" },
          "agentRoles": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$" } }
        }
      }
    },
    "totalChars": { "type": "integer", "minimum": 0, "maximum": 20000 },
    "truncated": { "type": "boolean" },
    "untrusted": { "const": true }
  }
}
