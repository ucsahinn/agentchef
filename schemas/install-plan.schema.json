{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentChef install plan manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "description",
    "profiles",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "codex-chef.install-plan.v2"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "target",
          "summary",
          "platforms",
          "collision",
          "backup",
          "risk",
          "conflictPolicy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "kind": {
            "enum": [
              "copy-file",
              "copy-directory",
              "copy-glob",
              "generate-mcp-profile",
              "write-marketplace",
              "refresh-plugin-cache",
              "git-config",
              "chmod",
              "skill-install",
              "json-merge",
              "link-directory",
              "write-claude-marketplace",
              "claude-plugin-register"
            ]
          },
          "target": {
            "enum": [
              "codex",
              "claude",
              "shared"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sourceByPlatform": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceGlob": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excludeBasenames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "destinationDir": {
            "type": "string",
            "minLength": 1
          },
          "configSource": {
            "type": "string",
            "minLength": 1
          },
          "pluginTarget": {
            "type": "string",
            "minLength": 1
          },
          "pluginId": {
            "type": "string",
            "minLength": 1
          },
          "ownershipMarker": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "adoptionFlag": {
            "enum": [
              "AdoptGitIgnore",
              "AdoptGitHook",
              "AdoptGitExcludesFile",
              "AdoptGitHooksPath"
            ]
          },
          "stateBackup": {
            "const": "codex-chef.global-git-guards-receipt@1"
          },
          "catalog": {
            "type": "string",
            "minLength": 1
          },
          "lock": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "requiresFlag": {
            "enum": [
              "InstallSkills",
              "InstallGitGuards"
            ]
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "windows",
                "unix"
              ]
            }
          },
          "collision": {
            "type": "string",
            "minLength": 1
          },
          "backup": {
            "type": "boolean"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "conflictPolicy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
