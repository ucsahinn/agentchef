{
  "description": "After a Codex session ends, schedule a fail-closed sweep for only the local MCP processes captured as descendants of that exact session owner.",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/codex-process-hygiene.mjs\" --session-end",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"& node (Join-Path $env:PLUGIN_ROOT 'scripts/codex-process-hygiene.mjs') --session-end\"",
            "timeout": 3,
            "statusMessage": "Scheduling stale MCP cleanup"
          }
        ]
      }
    ]
  }
}
