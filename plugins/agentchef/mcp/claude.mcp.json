{
  "mcpServers": {
    "context7": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-launch.mjs",
        "@upstash/context7-mcp@4.1.1"
      ]
    },
    "playwright": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp-launch.mjs",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--block-service-workers"
      ]
    },
    "serena": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/serena-pool.mjs",
        "bridge",
        "--project-root",
        "${CLAUDE_PROJECT_DIR}"
      ]
    }
  }
}
