{
  "name": "agentchef",
  "version": "1.3.1",
  "description": "Security-first AgentChef workflows for setup maintenance, planning, review, reconstruction, and verification.",
  "author": {
    "name": "AgentChef",
    "url": "https://github.com/ucsahinn/agentchef"
  },
  "homepage": "https://github.com/ucsahinn/agentchef",
  "repository": "https://github.com/ucsahinn/agentchef",
  "license": "MIT",
  "keywords": [
    "agentchef",
    "claude-code",
    "codex",
    "workflows",
    "security-first"
  ],
  "skills": "./skills/",
  "agents": [
    "./agents/backend-coordinator.md",
    "./agents/code-mapper.md",
    "./agents/code-reviewer.md",
    "./agents/codex-doctor.md",
    "./agents/context-architect.md",
    "./agents/design-reviewer.md",
    "./agents/devex-auditor.md",
    "./agents/devops-coordinator.md",
    "./agents/docs-author.md",
    "./agents/docs-researcher.md",
    "./agents/engineering-planner.md",
    "./agents/frontend-verifier.md",
    "./agents/google-seo-auditor.md",
    "./agents/leadership-coordinator.md",
    "./agents/marketing-coordinator.md",
    "./agents/mcp-integrator.md",
    "./agents/performance-auditor.md",
    "./agents/product-coordinator.md",
    "./agents/product-strategist.md",
    "./agents/prompt-architect.md",
    "./agents/qa-coordinator.md",
    "./agents/qa-lead.md",
    "./agents/release-verifier.md",
    "./agents/root-cause-debugger.md",
    "./agents/security-auditor.md",
    "./agents/spec-author.md",
    "./agents/test-verifier.md",
    "./agents/ui-coordinator.md"
  ],
  "mcpServers": "./mcp/claude.mcp.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/codex-process-hygiene.mjs",
              "--session-end",
              "--runtime",
              "claude"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
